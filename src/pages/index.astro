---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../config";

const posts = Object.values(
    import.meta.glob("./blog/*.{md,mdx}", { eager: true }),
)
    .filter((post) => !post?.frontmatter?.draft)
    .sort(
        (a, b) =>
            new Date(b?.frontmatter?.pubDate).valueOf() -
            new Date(a?.frontmatter?.pubDate).valueOf(),
    );
const latestPosts = posts.slice(0, 10);


const talks = [
    "2026-09-24 : [Table ronde] Designing hardware with elixir @ Espace Brut, Toulouse, France",
    "2026-10-18 : [Talk] Towards specialized instruments @ First Light Telescope Conference, Online + Portland, Oregon",
    "2026-10-21 : [Talk] Designing hardware with elixir @ Code BEAM Europe, Haarlem, Netherlands"
];

const contactRoutes = [
    {
        label: "Custom software for small or mid-size businesses",
        links: [
            { href: "https://turing-express.fr", label: "Turing-Express" },
        ],
    },
    {
        label: "Architecture firms and technical offices who create tenders and are tired of 100%-AI takes",
        links: [{ href: "https://alzo.archi", label: "Alzo" }],
    },
    {
        label: "Ultrafast and friendly telescopes + interferometry reports",
        links: [{ href: "https://chantepierre-optique.fr", label: "Chantepierre Optique" }],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={SITE_TITLE + " — independent Elixir / BEAM developer"}
            description="Lucas Sifoni — independent Elixir and BEAM developer in Cahors, co-founder of Alzo and telescope maker."
            type="website"
        />
        <style>
            section {
                margin-top: 2.5em;
            }
            h2 {
                font-weight: 400;
                border-bottom: 1px dotted gray;
                padding-bottom: 0.2em;
            }
            .currently-date {
                font-size: 0.85em;
                color: #333;
            }
            ul.currently {
                padding-left: 1.1em;
            }
            ul.currently li {
                margin-bottom: 0.3em;
            }
            ul.projects {
                list-style: none;
                padding: 0;
                max-width: none;
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1.6em;
            }
            ul.projects li {
                margin: 0;
            }
            ul.projects img,
            ul.projects .placeholder {
                width: 100%;
                aspect-ratio: 3 / 2;
                object-fit: cover;
                margin-bottom: 0.5em;
            }
            ul.projects .placeholder {
                background: #eee;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #999;
                font-size: 0.8em;
                box-shadow: none;
            }
            ul.projects h3 {
                margin: 0 0 0.3em 0;
            }
            ul.projects p {
                margin: 0 0 0.4em 0;
            }
            ul.contact {
                list-style: none;
                padding: 0;
                max-width: none;
            }
            ul.contact li {
                margin-bottom: 0.9em;
                padding-top: 0.75em;
                border-top: 1px dotted lightgray;
            }
            ul.contact li:first-child {
                padding-top: 0;
                border-top: none;
            }
            ul.contact .label {
                font-weight: 700;
            }
            .clink + .clink::before {
                content: " · ";
            }
            ul.posts-list {
                list-style: none;
                padding: 0;
                max-width: none;
            }
            ul.posts-list li {
                display: flex;
                align-items: baseline;
                flex-wrap: wrap;
                margin-bottom: 0.5em;
                padding-top: 0.5em;
                border-top: 1px dotted lightgray;
            }
            ul.posts-list time {
                flex: 0 0 13ch;
                font-size: 0.85em;
            }
            ul.posts-list a {
                text-decoration: none;
            }
            ul.posts-list a:hover {
                text-decoration: underline;
            }
            @media screen and (max-width: 700px) {
                ul.projects {
                    grid-template-columns: 1fr;
                }
                ul.posts-list time {
                    flex: 0 0 100%;
                }
            }
        </style>
    </head>
    <body>
        <Header have_langs={false} />
        <main>
            <div class="intro">
                <p>
                    I'm Lucas Sifoni, an independent developer since 2015, based in Cahors, in southwest France. Since 2018 I've worked mostly with Elixir and the BEAM. I created and run <a href="https://alzo.archi">Alzo</a>, a saas for architecture agencies.<br/>I also run
                    <a href="https://turing-express.fr">Turing-Express</a>, a
                    micro studio for custom software and consulting. I believe no company is too small to benefit from Elixir and the BEAM.<br/>
                    In addition to that, I am an amateur telescope builder and mirror/optics maker, and provide small-scale custom services at <a href="https://chantepierre-optique.fr">Chantepierre Optique</a>.
                </p>
            </div>

            <section>
                <h2>Recent public talks/interventions</h2>
                <ul class="currently">
                    {talks.map((item) => <li set:html={item}></li>)}
                </ul>
            </section>

            <section>
                <h2>Get in touch</h2>
                <ul class="contact">
                    {
                        contactRoutes.map((r) => (
                            <li>
                                <span class="label">{r.label}</span> : {r.body}{" "}
                                {r.links.map((l) => (
                                    <span class="clink">
                                        <a href={l.href}>{l.label}</a>
                                    </span>
                                ))}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section>
                <h2>Last articles</h2>
                <ul class="posts-list">
                    {
                        latestPosts.map((post) => (
                            <li>
                                <time datetime={post.frontmatter.pubDate}>
                                    {post.frontmatter.pubDate}
                                </time>
                                <a
                                    href={post.url}
                                    set:html={post.frontmatter.title.replace(
                                        "--",
                                        "<br/>",
                                    )}
                                />
                            </li>
                        ))
                    }
                </ul>
                <p><a href="/blog">Read the blog →</a></p>
            </section>
        </main>
        <Footer />
    </body>
</html>
