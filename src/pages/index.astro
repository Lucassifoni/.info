---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../config";

const posts = Object.values(
    import.meta.glob("./blog/*.{md,mdx}", { eager: true }),
)
    .filter((post) => !post?.frontmatter?.draft)
    .sort(
        (a, b) =>
            new Date(b?.frontmatter?.pubDate).valueOf() -
            new Date(a?.frontmatter?.pubDate).valueOf(),
    );
const latestPosts = posts.slice(0, 10);

const currentlyUpdated = "August 2026";
const currently = [
    "Soft-launched a femtoscaler side-project, chantepierre-optique.fr",
    "Working on a hardware contract with Elixir, which will be presented at <a href=\"https://codebeameurope.com/\">Code BEAM EU</a> this fall in Haarlem",
];

const talks = [
    "2026 09 24 : [Table ronde] Designing hardware with elixir @ Espace Brut, Toulouse, France",
    "2026 10 16-18 : [Talk] Towards specialized instruments @ First Light Telescope Conference, Online + Portland, Oregon",
    "2026 10 21-23 : [Talk] Designing hardware with elixir @ Code BEAM Europe, Haarlem, Netherlands"
];

const projects = [
    {
        title: "Alzo",
        body: "Alzo is a database, communication and publishing tool for architecture firms and technical offices, built to remove the repetitive overhead of running their projects, with or without AI (their choice).",
        href: "https://alzo.archi",
        linkLabel: "alzo.archi",
        img: "",
    },
    {
        title: "An elixir telescope build log",
        body: "An experimental project, presented at Code BEAM EU 2023. A terrestrial telescope I built to watch birds, trees and nearby things up close. It ran on Nerves and could be driven from a phone or from a physical remote I printed.",
        href: "/blog/Scope-sim-2",
        linkLabel: "Read the series",
        img: "",
    },
    {
        title: "Ovo2, a small language",
        body: "A programming language written from scratch in Elixir. Lexer, parser, interpreter, and a proof of concept of a visual editor. It does only one thing: pure transformations of JSON-like data, without I/O, and looks like elixir, so it could be used as a kind of sandbox. I used it to talk about language design at ElixirConf EU 2024.",
        href: "/blog/small-lang-elixir-5",
        linkLabel: "Read the series",
        img: "",
    },
    {
        title: "Telescope mirrors",
        body: "I grind telescope mirrors by hand to within tens of nanometers of the right curve, and build instruments around them. The most recent is a fully working 76/300 telescope that folds down small enough to fit in a jacket pocket. You will also find a few imaging simulations, under the astronomy tag on the blog.",
        href: "/blog/miniscope-tiny-telescope",
        linkLabel: "Read the write-up",
        img: "",
    },
];

const contactRoutes = [
    {
        label: "Custom software for small or mid-size businesses",
        links: [
            { href: "https://turing-express.fr", label: "Turing-Express" },
        ],
    },
    {
        label: "Architecture firms and technical offices who create tenders and are tired of 100%-AI takes",
        links: [{ href: "https://alzo.archi", label: "Alzo" }],
    },
    {
        label: "Ultrafast telescopes, custom optics, interferometry reports",
        links: [{ href: "https://chantepierre-optique.fr", label: "Chantepierre Optique" }],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={SITE_TITLE + " — independent Elixir / BEAM developer"}
            description="Lucas Sifoni — independent Elixir and BEAM developer in Cahors, co-founder of Alzo and telescope maker. Projects, consulting, and a blog on Elixir and optics."
            type="website"
        />
        <style>
            section {
                margin-top: 2.5em;
            }
            h2 {
                font-weight: 400;
                border-bottom: 1px dotted gray;
                padding-bottom: 0.2em;
            }
            .currently-date {
                font-size: 0.85em;
                color: #333;
            }
            ul.currently {
                padding-left: 1.1em;
            }
            ul.currently li {
                margin-bottom: 0.3em;
            }
            ul.projects {
                list-style: none;
                padding: 0;
                max-width: none;
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1.6em;
            }
            ul.projects li {
                margin: 0;
            }
            ul.projects img,
            ul.projects .placeholder {
                width: 100%;
                aspect-ratio: 3 / 2;
                object-fit: cover;
                margin-bottom: 0.5em;
            }
            ul.projects .placeholder {
                background: #eee;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #999;
                font-size: 0.8em;
                box-shadow: none;
            }
            ul.projects h3 {
                margin: 0 0 0.3em 0;
            }
            ul.projects p {
                margin: 0 0 0.4em 0;
            }
            ul.contact {
                list-style: none;
                padding: 0;
                max-width: none;
            }
            ul.contact li {
                margin-bottom: 0.9em;
                padding-top: 0.75em;
                border-top: 1px dotted lightgray;
            }
            ul.contact li:first-child {
                padding-top: 0;
                border-top: none;
            }
            ul.contact .label {
                font-weight: 700;
            }
            .clink + .clink::before {
                content: " · ";
            }
            ul.posts-list {
                list-style: none;
                padding: 0;
                max-width: none;
            }
            ul.posts-list li {
                display: flex;
                align-items: baseline;
                flex-wrap: wrap;
                margin-bottom: 0.5em;
                padding-top: 0.5em;
                border-top: 1px dotted lightgray;
            }
            ul.posts-list time {
                flex: 0 0 13ch;
                font-size: 0.85em;
            }
            ul.posts-list a {
                text-decoration: none;
            }
            ul.posts-list a:hover {
                text-decoration: underline;
            }
            @media screen and (max-width: 700px) {
                ul.projects {
                    grid-template-columns: 1fr;
                }
                ul.posts-list time {
                    flex: 0 0 100%;
                }
            }
        </style>
    </head>
    <body>
        <Header have_langs={false} />
        <main>
            <div class="intro">
                <p>
                    I'm Lucas Sifoni, an independent developer since 2015, based in Cahors, in southwest France. Since 2018 I've worked mostly with Elixir and the BEAM. I created and run <a href="https://alzo.archi">Alzo</a>, a saas for architecture agencies.<br/>I also run
                    <a href="https://turing-express.fr">Turing-Express</a>, a
                    micro studio for custom software and consulting. I believe no company is too small to benefit from Elixir and the BEAM.<br/>
                    In addition to that, I am an amateur telescope builder and mirror/optics maker, and provide small-scale custom services at <a href="https://chantepierre-optique.fr">Chantepierre Optique</a>.
                </p>
            </div>

            <section>
                <h2>Next public talks/interventions</h2>
                <ul class="currently">
                    {talks.map((item) => <li set:html={item}></li>)}
                </ul>
            </section>

            <section>
                <h2>Currently</h2>
                <p class="currently-date">Updated {currentlyUpdated}</p>
                <ul class="currently">
                    {currently.map((item) => <li set:html={item}></li>)}
                </ul>
            </section>

            <section>
                <h2>Get in touch</h2>
                <ul class="contact">
                    {
                        contactRoutes.map((r) => (
                            <li>
                                <span class="label">{r.label}</span> : {r.body}{" "}
                                {r.links.map((l) => (
                                    <span class="clink">
                                        <a href={l.href}>{l.label}</a>
                                    </span>
                                ))}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section>
                <h2>Last articles from the blog</h2>
                <ul class="posts-list">
                    {
                        latestPosts.map((post) => (
                            <li>
                                <time datetime={post.frontmatter.pubDate}>
                                    {post.frontmatter.pubDate}
                                </time>
                                <a
                                    href={post.url}
                                    set:html={post.frontmatter.title.replace(
                                        "--",
                                        "<br/>",
                                    )}
                                />
                            </li>
                        ))
                    }
                </ul>
                <p><a href="/blog">Read the blog →</a></p>
            </section>
        </main>
        <Footer />
    </body>
</html>
